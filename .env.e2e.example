# Copy to .env.e2e (gitignored) and fill in real values, then run:
#   ./scripts/run_e2e_local.sh
#
# Values may also be 1Password references (e.g. op://vault/item/field); in that
# case run via `op run --env-file=.env.e2e -- ./scripts/run_e2e_local.sh` instead,
# so `op` resolves them before the script sees them.

API_USER=
API_TOKEN=
PA_PASSWORD=
# Full push URL with embedded credentials, e.g.:
# DEMO_REPO_URL=https://x-access-token:<token>@github.com/caktus/dsd-pythonanywhere-testproj.git
DEMO_REPO_URL=
DEMO_REPO_NAME=dsd-pythonanywhere-testproj
